<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_advanced_filter_list" model="ir.ui.view">
        <field name="name">advanced.filter.list</field>
        <field name="model">advanced.filter</field>
        <field name="arch" type="xml">
            <list string="Advanced Filters">
                <field name="name"/>
                <field name="main_model_id"/>
                <field name="relation_mode"/>
                <field name="related_model_id"/>
                <field name="related_match_mode"/>
                <field name="is_shared"/>
                <field name="is_default"/>
                <field name="user_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_advanced_filter_form" model="ir.ui.view">
        <field name="name">advanced.filter.form</field>
        <field name="model">advanced.filter</field>
        <field name="arch" type="xml">
            <form string="Advanced Filter">
                <header>
                    <button name="action_apply_filter" string="Apply Filter" type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="main_model_id" options="{'no_create': true, 'no_create_edit': true, 'no_open': true}"/>
                            <field name="relation_mode"/>
                            <field name="relation_candidate_model_ids" invisible="1"/>
                            <field name="result_relation_field_relation" invisible="1"/>
                            <field name="result_relation_field_id"
                                invisible="relation_mode != 'child_parent_child'"
                                required="relation_mode == 'child_parent_child'"
                                domain="[('ttype', '=', 'many2one'), ('model', '=', main_model)]"
                                options="{'no_create': true, 'no_create_edit': true, 'no_open': true}"/>
                            <field name="related_model_id"
                                invisible="relation_mode == 'direct'"
                                required="relation_mode != 'direct'"
                                domain="[('id', 'in', relation_candidate_model_ids)]"
                                options="{'no_create': true, 'no_create_edit': true, 'no_open': true}"/>
                            <field name="relation_field_model" invisible="1"/>
                            <field name="relation_field_relation" invisible="1"/>
                            <field name="relation_field_id"
                                invisible="relation_mode == 'direct'"
                                required="relation_mode != 'direct'"
                                domain="[('ttype', '=', 'many2one'), ('model', '=', relation_field_model), ('relation', '=', relation_field_relation)]"
                                options="{'no_create': true, 'no_create_edit': true, 'no_open': true}"/>
                        </group>
                        <group>
                            <field name="related_match_mode"/>
                            <field name="duplicate_detection" invisible="relation_mode != 'direct'"/>
                            <label for="duplicate_count_operator" string="Count Condition" invisible="not duplicate_detection or relation_mode != 'direct'"/>
                            <div class="o_row" invisible="not duplicate_detection or relation_mode != 'direct'">
                                <field name="duplicate_count_operator"/>
                                <field name="duplicate_count"/>
                            </div>
                            <field name="is_shared"/>
                            <field name="is_default"/>
                            <field name="active"/>
                            <field name="result_count" readonly="1"/>
                            <button name="action_refresh_result_count" string="Refresh Count" type="object" class="btn-secondary"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Conditions">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="condition_model" column_invisible="1"/>
                                    <field name="condition_domain" widget="domain" options="{'model': 'condition_model', 'in_dialog': true}"/>
                                </list>
                            </field>
                            <group>
                                <field name="result_count" string="Final Result Count" readonly="1"/>
                            </group>
                        </page>
                        <page string="Group By">
                            <field name="group_by_line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="field_id" options="{'no_create': true, 'no_create_edit': true, 'no_open': true}"/>
                                    <field name="date_interval"/>
                                </list>
                            </field>
                        </page>
                        <page string="Duplicate Grouping" invisible="not duplicate_detection or relation_mode != 'direct'">
                            <field name="duplicate_group_by_line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="field_id" options="{'no_create': true, 'no_create_edit': true, 'no_open': true}"/>
                                    <field name="date_interval"/>
                                </list>
                            </field>
                        </page>
                        <page string="Technical">
                            <group>
                                <field name="main_model" readonly="1"/>
                                <field name="related_model" readonly="1"/>
                            </group>
                            <field name="condition_summary" readonly="1" nolabel="1"/>
                            <field name="computed_domain" readonly="1" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_advanced_filter_line_form" model="ir.ui.view">
        <field name="name">advanced.filter.line.form</field>
        <field name="model">advanced.filter.line</field>
        <field name="arch" type="xml">
            <form string="Condition">
                <sheet>
                    <group>
                        <field name="filter_id" readonly="1"/>
                        <field name="condition_model_id" readonly="1"/>
                        <field name="condition_model" invisible="1"/>
                        <field name="condition_domain" widget="domain" options="{'model': 'condition_model', 'in_dialog': true}"/>
                    </group>
                    <group string="Readable Condition">
                        <field name="condition_display" readonly="1" nolabel="1"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Confirm" special="save" class="btn-primary"/>
                    <button string="Discard" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_advanced_filter_search" model="ir.ui.view">
        <field name="name">advanced.filter.search</field>
        <field name="model">advanced.filter</field>
        <field name="arch" type="xml">
            <search string="Advanced Filters">
                <field name="name"/>
                <field name="main_model_id"/>
                <field name="related_model_id"/>
                <filter name="my_filters" string="My Filters" domain="[('user_id', '=', uid)]"/>
                <filter name="shared" string="Shared" domain="[('is_shared', '=', True)]"/>
                <filter name="defaults" string="Default" domain="[('is_default', '=', True)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_main_model" string="Target Model" context="{'group_by': 'main_model_id'}"/>
                    <filter name="group_by_relation_mode" string="Relation Mode" context="{'group_by': 'relation_mode'}"/>
                    <filter name="group_by_owner" string="Owner" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_advanced_filter" model="ir.actions.act_window">
        <field name="name">Advanced Filters</field>
        <field name="res_model">advanced.filter</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_advanced_filter_search"/>
        <field name="context">{'search_default_my_filters': 1}</field>
    </record>

    <menuitem id="menu_advanced_filter_root"
        name="Advanced Filters"
        sequence="100"/>
    <menuitem id="menu_advanced_filter"
        name="Manage Filters"
        parent="menu_advanced_filter_root"
        action="action_advanced_filter"
        sequence="10"/>
</odoo>
