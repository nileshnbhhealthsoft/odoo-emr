<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_demo_edi_claim_list" model="ir.ui.view">
        <field name="name">edi.claim.list.demo</field>
        <field name="model">edi.claim</field>
        <field name="arch" type="xml">
            <list string="Demo Claims">
                <field name="claim_number"/>
                <field name="payer_name"/>
                <field name="patient_control_number"/>
                <field name="patient_first_name"/>
                <field name="patient_last_name"/>
                <field name="patient_dob"/>
                <field name="service_date"/>
                <field name="payment_date"/>
                <field name="service_provider_last_name"/>
                <field name="claim_status_text"/>
                <field name="charge_amount"/>
                <field name="payment_amount"/>
                <field name="claim_bucket"/>
            </list>
        </field>
    </record>

    <record id="view_demo_edi_claim_form" model="ir.ui.view">
        <field name="name">edi.claim.form.demo</field>
        <field name="model">edi.claim</field>
        <field name="arch" type="xml">
            <form string="Demo Claim">
                <sheet>
                    <group>
                        <group>
                            <field name="claim_number"/>
                            <field name="payer_control_number"/>
                            <field name="patient_control_number"/>
                            <field name="payer_name"/>
                            <field name="payer_type"/>
                        </group>
                        <group>
                            <field name="service_date"/>
                            <field name="payment_date"/>
                            <field name="service_provider_last_name"/>
                            <field name="claim_status_text"/>
                            <field name="claim_bucket"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="patient_first_name"/>
                            <field name="patient_last_name"/>
                            <field name="patient_dob"/>
                        </group>
                        <group>
                            <field name="charge_amount"/>
                            <field name="payment_amount"/>
                            <field name="total_payment_amount"/>
                            <field name="payment_percentage"/>
                        </group>
                    </group>
                    <field name="service_ids">
                        <list editable="bottom">
                            <field name="line_no"/>
                            <field name="date_start"/>
                            <field name="cpt_code"/>
                            <field name="cpt_type"/>
                            <field name="service_description"/>
                            <field name="icd_10_codes"/>
                            <field name="charge_amount"/>
                            <field name="paid_amount"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_demo_edi_service_list" model="ir.ui.view">
        <field name="name">edi.service.list.demo</field>
        <field name="model">edi.service</field>
        <field name="arch" type="xml">
            <list string="Demo Services">
                <field name="date_start"/>
                <field name="claim_id"/>
                <field name="patient_first_name"/>
                <field name="patient_last_name"/>
                <field name="patient_control_number"/>
                <field name="service_provider_last_name"/>
                <field name="cpt_code"/>
                <field name="cpt_type"/>
                <field name="service_description"/>
                <field name="icd_10_codes"/>
                <field name="charge_amount"/>
                <field name="paid_amount"/>
                <field name="claim_payment_amount"/>
                <field name="claim_custom_group"/>
            </list>
        </field>
    </record>

    <record id="view_demo_edi_service_search" model="ir.ui.view">
        <field name="name">edi.service.search.demo</field>
        <field name="model">edi.service</field>
        <field name="arch" type="xml">
            <search string="Demo Services">
                <field name="claim_id"/>
                <field name="patient_control_number"/>
                <field name="patient_last_name"/>
                <field name="cpt_code"/>
                <field name="icd_10_codes"/>
                <field name="payer_name"/>
                <filter name="paid" string="Paid" domain="[('paid_amount', '&gt;', 0)]"/>
                <filter name="unpaid" string="Unpaid" domain="[('paid_amount', '=', 0)]"/>
                <filter name="g0447" string="G0447" domain="[('cpt_code', '=', 'G0447')]"/>
                <filter name="icd_e669" string="ICD E66.9" domain="[('icd_10_codes', 'ilike', 'E66.9')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_claim" string="Claim" context="{'group_by': 'claim_id'}"/>
                    <filter name="group_by_year" string="Service Year" context="{'group_by': 'date_start:year'}"/>
                    <filter name="group_by_month" string="Service Month" context="{'group_by': 'date_start:month'}"/>
                    <filter name="group_by_provider" string="Provider" context="{'group_by': 'service_provider_last_name'}"/>
                    <filter name="group_by_cpt_type" string="CPT Type" context="{'group_by': 'cpt_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_demo_edi_claim" model="ir.actions.act_window">
        <field name="name">Demo Claims</field>
        <field name="res_model">edi.claim</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_demo_edi_service" model="ir.actions.act_window">
        <field name="name">Demo Services</field>
        <field name="res_model">edi.service</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="search_view_id" ref="view_demo_edi_service_search"/>
    </record>

    <menuitem id="menu_demo_edi_claim"
        name="Demo Claims"
        parent="menu_advanced_filter_root"
        action="action_demo_edi_claim"
        sequence="30"/>
    <menuitem id="menu_demo_edi_service"
        name="Demo Services"
        parent="menu_advanced_filter_root"
        action="action_demo_edi_service"
        sequence="40"/>
</odoo>
