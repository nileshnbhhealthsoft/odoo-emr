<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <!-- EDI Service List View -->
    <record id="view_edi_service_list" model="ir.ui.view">
        <field name="name">edi.service.list</field>
        <field name="model">edi.service</field>
        <field name="arch" type="xml">
            <list>
                <field name="claim_id"/>
            <field name="line_no"/>
            <field name="line_control_number"/>
            <field name="patient_control_number"/>
            <field name="pat_id"/>
            <field name="cpt_code"/>
            <field name="cpt_type"/>
            <field name="revenue_code"/>
            <field name="modifier1"/>
            <field name="modifier2"/>
            <field name="modifier3"/>
            <field name="modifier4"/>
            <field name="original_procedure_code"/>
            <field name="unit_count"/>
            <field name="charge_amount"/>
            <field name="paid_amount"/>
            <field name="date_start"/>
            <field name="date_end"/>
            <field name="payment_date"/>
            <field name="production_date"/>
            <field name="icd_10"/>
            <field name="icd_10_codes"/>
            <field name="group_codes_csv"/>
            <field name="carc_codes_csv"/>
            <field name="carc_code1"/>
            <field name="carc_code2"/>
            <field name="rarc_csv"/>
            <field name="rarc_code1"/>
            <field name="rarc_code2"/>
            <field name="sarts1"/>
            <field name="sarts2"/>
            <field name="rarts1"/>
            <field name="rarts2"/>
            <field name="payer_name"/>
            <field name="payer_type"/>
            <field name="claim_status_text"/>
            <field name="claim_charge_amount"/>
            <field name="claim_payment_amount"/>
            <field name="payment_percentage"/>
            <field name="service_provider_identifier"/>
            <field name="patient_age_years"/>
            <field name="patient_age_months"/>
            </list>
        </field>
    </record>


    <!-- EDI Service Form View -->
    <record id="view_edi_service_form" model="ir.ui.view">
        <field name="name">edi.service.form</field>
        <field name="model">edi.service</field>
        <field name="arch" type="xml">
            <form>
                <sheet>

                    <group string="Claim">
                        <field name="claim_id"/>
                        <field name="line_no"/>
                        <field name="line_control_number"/>
                        <field name="patient_control_number"/>
                        <field name="pat_id"/>
                    </group>

                    <group string="Procedure">
                        <field name="cpt_code"/>
                        <field name="cpt_type"/>
                        <field name="revenue_code"/>
                        <field name="original_procedure_code"/>
                        <field name="modifier1"/>
                        <field name="modifier2"/>
                        <field name="modifier3"/>
                        <field name="modifier4"/>
                        <field name="unit_count"/>
                    </group>

                    <group string="Amounts">
                        <field name="charge_amount"/>
                        <field name="paid_amount"/>
                        <field name="claim_charge_amount"/>
                        <field name="claim_payment_amount"/>
                        <field name="payment_percentage"/>
                    </group>

                    <group string="Dates">
                        <field name="date_start"/>
                        <field name="date_end"/>
                        <field name="payment_date"/>
                        <field name="production_date"/>
                    </group>

                    <group string="Diagnosis">
                        <field name="icd_10"/>
                        <field name="icd_10_codes"/>
                    </group>

                    <group string="Adjustment Codes">
                        <field name="group_codes_csv"/>
                        <field name="carc_codes_csv"/>
                        <field name="carc_code1"/>
                        <field name="carc_code2"/>
                        <field name="rarc_csv"/>
                        <field name="rarc_code1"/>
                        <field name="rarc_code2"/>
                    </group>

                    <group string="Provider">
                        <field name="service_provider_identifier"/>
                    </group>

                    <group string="Patient">
                        <field name="patient_age_years"/>
                        <field name="patient_age_months"/>
                    </group>

                </sheet>
            </form>
        </field>
    </record>


    <!-- Action -->
    <record id="action_edi_service" model="ir.actions.act_window">
        <field name="name">EDI Services</field>
        <field name="res_model">edi.service</field>
        <field name="view_mode">list,form</field>
    </record>


    <!-- Menu -->
    <menuitem
        id="menu_edi_service"
        name="Services"
        parent="edi_claim.menu_edi_root"
        action="action_edi_service"
        sequence="20"
    />

</odoo>