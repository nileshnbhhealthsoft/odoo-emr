<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="advanced_filter_engine.AdvancedFilterFavoriteItem">
        <AccordionItem class="'o_advanced_filter_favorites text-truncate'" selected="hasFilters" description.translate="Advanced Filters">
            <div class="o_afe_panel">
                <div class="o_afe_header d-flex align-items-center gap-2">
                    <div class="o_afe_title flex-grow-1 text-truncate">
                        <span class="fw-semibold">Advanced Filters</span>
                        <span class="text-muted text-truncate" t-esc="state.modelLabel || resModel"/>
                    </div>
                    <button class="btn btn-link btn-sm o_afe_refresh" type="button" title="Refresh filters" t-on-click.stop="loadFilters">
                        <i class="fa fa-refresh"/>
                    </button>
                </div>

                <div t-if="state.isLoading" class="o_afe_status text-muted">
                    Loading filters...
                </div>

                <div t-elif="hasFilters" class="o_afe_filter_list">
                    <div
                        t-foreach="state.filters"
                        t-as="filter"
                        t-key="filter.id"
                        class="o_afe_filter_item d-flex align-items-center"
                    >
                        <button
                            type="button"
                            class="o_afe_filter_button btn text-start flex-grow-1"
                            t-on-click.stop="() => this.applyFilter(filter)"
                            t-att-title="filter.name"
                        >
                            <i t-att-class="filter.is_default ? 'fa fa-star text-warning' : 'fa fa-sliders o_afe_filter_icon'"/>
                            <span class="o_afe_filter_name text-truncate" t-esc="filter.name"/>
                            <span t-if="filter.is_shared" class="o_afe_shared text-muted">Shared</span>
                        </button>
                        <button
                            type="button"
                            class="o_afe_row_action btn"
                            title="Edit"
                            t-on-click.stop="() => this.editFilter(filter)"
                        >
                            <i class="fa fa-pencil"/>
                        </button>
                        <button
                            t-if="filter.is_owner"
                            type="button"
                            class="o_afe_row_action btn"
                            title="Delete"
                            t-on-click.stop="() => this.deleteFilter(filter)"
                        >
                            <i class="fa fa-trash"/>
                        </button>
                    </div>
                </div>

                <div t-else="" class="o_afe_status text-muted">
                    No advanced filters saved for this model.
                </div>

                <div class="o_afe_footer">
                    <button class="btn btn-primary btn-sm w-100" type="button" t-on-click.stop="createFilter">
                        New Advanced Filter
                    </button>
                    <button class="btn btn-outline-primary btn-sm w-100" type="button" t-on-click.stop="openManager">
                        Manage Advanced Filters
                    </button>
                </div>
            </div>
        </AccordionItem>
    </t>

    <t t-name="advanced_filter_engine.AdvancedFilterCommentsField">
        <div t-att-class="this.commentColumnClass()" t-on-click.stop="stopPropagation" t-on-mousedown.stop="stopPropagation">
            <div class="o_afe_comment_list">
                <div t-if="state.isLoading" class="o_afe_comment_empty">
                    Loading...
                </div>
                <div
                    t-else=""
                    t-foreach="state.comments"
                    t-as="comment"
                    t-key="comment.id"
                    t-att-class="this.commentItemClass(comment)"
                    t-att-style="this.commentUserStyle(comment)"
                    t-on-click="() => this.startCommentEdit(comment)"
                    t-on-mouseenter="() => this.onCommentMouseEnter(comment)"
                    t-on-mouseleave="() => this.onCommentMouseLeave(comment)"
                >
                    <t t-if="this.isEditingComment(comment)">
                        <span class="o_afe_comment_prefix">
                            <strong class="o_afe_comment_author" t-esc="this.commentDisplayName(comment)"/>
                            <span> [</span>
                            <span class="o_afe_comment_date" t-esc="this.compactDate(comment)"/>
                            <span>]: </span>
                        </span>
                        <input
                            type="text"
                            class="o_afe_comment_inline_input"
                            t-att-data-comment-id="comment.id"
                            t-att-value="state.editCommentValue"
                            t-on-input="onCommentEditInput"
                            t-on-keydown="(event) => this.onCommentEditKeydown(event, comment)"
                            t-on-click.stop="stopPropagation"
                        />
                        <button
                            t-if="this.isCommentEditable(comment)"
                            type="button"
                            class="btn o_afe_comment_delete"
                            title="Delete comment"
                            t-on-click.stop="() => this.deleteComment(comment)"
                        >
                            <i class="fa fa-trash"/>
                        </button>
                    </t>
                    <span t-else="" class="o_afe_comment_line">
                        <span class="o_afe_comment_prefix">
                            <strong class="o_afe_comment_author" t-esc="this.commentDisplayName(comment)"/>
                            <span> [</span>
                            <span class="o_afe_comment_date" t-esc="this.compactDate(comment)"/>
                            <span>]: </span>
                        </span>
                        <span class="o_afe_comment_body" t-esc="this.commentBodyText(comment)" t-att-title="comment.comment"/>
                        <button
                            t-if="this.isCommentLong(comment)"
                            type="button"
                            class="btn o_afe_comment_more"
                            t-att-title="this.isCommentExpanded(comment) ? 'Show less' : 'Show full comment'"
                            t-on-click.stop="() => this.toggleCommentExpanded(comment)"
                        >
                            <t t-esc="this.isCommentExpanded(comment) ? 'less' : 'more'"/>
                        </button>
                        <button
                            t-if="this.isCommentEditable(comment)"
                            type="button"
                            class="btn o_afe_comment_delete"
                            title="Delete comment"
                            t-on-click.stop="() => this.deleteComment(comment)"
                        >
                            <i class="fa fa-trash"/>
                        </button>
                    </span>
                </div>
            </div>
            <button
                t-ref="commentIcon"
                type="button"
                class="btn o_afe_comment_icon"
                title="Comments"
                t-on-click.stop="openComposer"
            >
                <i class="o_button_icon fa fa-fw fa-external-link"/>
            </button>
            <div
                t-if="state.isPopupOpen"
                class="o_afe_comment_popup"
                t-att-style="state.popupStyle"
                t-on-click.stop="stopPropagation"
            >
                <div class="o_afe_comment_popup_title">Write a comment</div>
                <textarea
                    t-ref="newComment"
                    class="o_afe_comment_textarea"
                    placeholder="Write a comment..."
                    t-att-value="state.draft"
                    t-on-input="onPopupInput"
                    t-on-keydown="onComposerKeydown"
                    t-on-click.stop="stopPropagation"
                />
                <div class="o_afe_comment_popup_actions">
                    <button
                        type="button"
                        class="btn btn-primary btn-sm o_afe_comment_save"
                        t-att-disabled="!state.draft.trim() || state.isSending"
                        t-on-click.stop="savePopup"
                    >
                        Send
                    </button>
                </div>
            </div>
        </div>
    </t>
</templates>
