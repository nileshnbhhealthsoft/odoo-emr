<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_data_filter_wizard_form" model="ir.ui.view">
        <field name="name">data.filter.wizard.form</field>
        <field name="model">data.filter.wizard</field>
        <field name="arch" type="xml">
            <form string="Data Filter">
                <sheet>
                    <group>
                        <field name="model_id" options="{'no_create': true, 'no_create_edit': true, 'no_open': true}"/>
                        <field name="model_name" invisible="1"/>
                        <field name="domain" widget="domain" options="{'model': 'model_name', 'in_dialog': true}"/>
                        <field name="group_by_field_ids"
                            widget="many2many_tags"
                            options="{'no_create': true, 'no_create_edit': true, 'no_open': true}"/>
                        <field name="result_count" readonly="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_open_records" string="Open Records" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_data_filter_wizard" model="ir.actions.act_window">
        <field name="name">Data Filter</field>
        <field name="res_model">data.filter.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_data_filter_wizard"
        name="Data Filter Wizard"
        parent="menu_advanced_filter_root"
        action="action_data_filter_wizard"
        sequence="20"/>
</odoo>
